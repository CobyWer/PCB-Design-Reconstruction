    def generate_coordinate_comparison_report(self, data, layer_idx, output_filename):
        """
        Generate a text report summarizing:
            - pad coordinates in pixels and mm
            - via coordinates and sizes
            - trace coordinates before/after correction
            - how many segments changed during correction

        Saves report to output_filename.
        """

        MMpixelX = data['MMpixelX']
        MMpixelY = data['MMpixelY']

        with open(output_filename, 'w') as f:
            f.write(f"COORDINATE COMPARISON REPORT - Layer {layer_idx}\n")
            f.write("=" * 80 + "\n\n")

            f.write(f"Board Dimensions: {data['boardX']} x {data['boardY']} mm\n")
            f.write(f"Conversion Factor: {MMpixelX:.6f} mm/pixel (X), {MMpixelY:.6f} mm/pixel (Y)\n\n")

            # -----------------------------------------
            # Pad section
            # -----------------------------------------
            f.write(f"PADS ({len(data['pad_positions'][layer_idx])} total)\n")
            f.write("-" * 80 + "\n")

            for pad_idx, (pad_pts, pad_pos) in enumerate(zip(
                data['pad_points'][layer_idx],
                data['pad_positions'][layer_idx]
            )):
                sumX = sum([p[0] for p in pad_pts])
                sumY = sum([p[1] for p in pad_pts])
                avgPoint = (sumX / len(pad_pts), sumY / len(pad_pts))

                pixel_x = avgPoint[0]
                pixel_y = avgPoint[1]

                kicad_x = pixel_x * MMpixelX + 12
                kicad_y = pixel_y * MMpixelY + 12

                x_coords = [p[0] for p in pad_pts]
                y_coords = [p[1] for p in pad_pts]
                pad_width = (max(x_coords) - min(x_coords)) * MMpixelX
                pad_height = (max(y_coords) - min(y_coords)) * MMpixelY

                f.write(f"\nPad {pad_idx}:\n")
                f.write(f"  Original (pixels): ({pixel_x:.2f}, {pixel_y:.2f})\n")
                f.write(f"  KiCad (mm):        ({kicad_x:.3f}, {kicad_y:.3f})\n")
                f.write(f"  Size (mm):         {pad_width:.3f} x {pad_height:.3f}\n")

            # -----------------------------------------
            # Via section
            # -----------------------------------------
            f.write(f"\n\nVIAS ({len(data['via_positions'][layer_idx])} total)\n")
            f.write("-" * 80 + "\n")

            for via_idx, via_pos in enumerate(data['via_positions'][layer_idx]):
                for pos in via_pos:
                    pixel_x = pos[0]
                    pixel_y = pos[1]

                    kicad_x = pixel_x * MMpixelX + 12
                    kicad_y = pixel_y * MMpixelY + 12

                    diameter = data['via_diameters'][layer_idx][via_idx] * MMpixelX
                    drill = diameter * 0.6

                    f.write(f"\nVia {via_idx}:\n")
                    f.write(f"  Original (pixels): ({pixel_x:.2f}, {pixel_y:.2f})\n")
                    f.write(f"  KiCad (mm):        ({kicad_x:.3f}, {kicad_y:.3f})\n")
                    f.write(f"  Diameter (mm):     {diameter:.3f}\n")
                    f.write(f"  Drill (mm):        {drill:.3f}\n")

            # -----------------------------------------
            # Trace section
            # -----------------------------------------
            f.write(f"\n\nTRACES ({len(data['traces_after'][layer_idx])} total)\n")
            f.write("-" * 80 + "\n")

            corrections_made = 0
            total_segments = 0

            for trace_idx, (trace_before, trace_after) in enumerate(zip(
                data['traces_before'][layer_idx],
                data['traces_after'][layer_idx]
            )):
                f.write(f"\nTrace {trace_idx} ({len(trace_after)} segments):\n")

                for seg_idx, (seg_before, seg_after) in enumerate(zip(trace_before, trace_after)):
                    total_segments += 1

                    start_before, end_before = seg_before[0]
                    start_after, end_after = seg_after[0]
                    width = seg_after[1]

                    # Check whether either endpoint changed during correction
                    start_changed = (start_before != start_after)
                    end_changed = (end_before != end_after)

                    if start_changed or end_changed:
                        corrections_made += 1
                        f.write(f"  Segment {seg_idx}: ** CORRECTED **\n")
                    else:
                        f.write(f"  Segment {seg_idx}:\n")

                    f.write(f"    Original Start (pixels): ({start_before[0]:.2f}, {start_before[1]:.2f})\n")
                    f.write(f"    Original End (pixels):   ({end_before[0]:.2f}, {end_before[1]:.2f})\n")

                    kicad_start_x = start_after[0] * MMpixelX + 12
                    kicad_start_y = start_after[1] * MMpixelY + 12
                    kicad_end_x = end_after[0] * MMpixelX + 12
                    kicad_end_y = end_after[1] * MMpixelY + 12

                    f.write(f"    KiCad Start (mm):        ({kicad_start_x:.3f}, {kicad_start_y:.3f})\n")
                    f.write(f"    KiCad End (mm):          ({kicad_end_x:.3f}, {kicad_end_y:.3f})\n")
                    f.write(f"    Width (mm):              {width * MMpixelX:.3f}\n")

                    if start_changed or end_changed:
                        # Report how much endpoints moved in pixel space
                        if start_changed:
                            start_movement = math.sqrt(
                                (start_after[0] - start_before[0]) ** 2 +
                                (start_after[1] - start_before[1]) ** 2
                            )
                            f.write(f"    Start moved: {start_movement:.2f} pixels\n")

                        if end_changed:
                            end_movement = math.sqrt(
                                (end_after[0] - end_before[0]) ** 2 +
                                (end_after[1] - end_before[1]) ** 2
                            )
                            f.write(f"    End moved:   {end_movement:.2f} pixels\n")

            # -----------------------------------------
            # Summary section
            # -----------------------------------------
            f.write(f"\n\nSUMMARY\n")
            f.write("=" * 80 + "\n")
            f.write(f"Total segments:      {total_segments}\n")
            f.write(f"Segments corrected:  {corrections_made}\n")

            if total_segments > 0:
                f.write(f"Correction rate:     {100 * corrections_made / total_segments:.1f}%\n")
            else:
                f.write(f"Correction rate:     N/A (no traces on this layer)\n")

        print(f"Saved comparison report to: {output_filename}")


def parse_layer_input(user_input, total_layers):
    """
    Parse a user string describing which layers to use.

    Supported formats:
        "0"       -> [0]
        "0,2,4"   -> [0, 2, 4]
        "0-3"     -> [0, 1, 2, 3]
        "all"     -> [0, 1, ..., total_layers-1]

    Returns:
        sorted list of unique layer indices
    """
    user_input = user_input.strip().lower()

    if user_input == 'all':
        return list(range(total_layers))

    layers = []
    parts = user_input.split(',')

    for part in parts:
        part = part.strip()

        if '-' in part:
            # Handle a range like "0-3"
            start, end = part.split('-')
            start = int(start.strip())
            end = int(end.strip())
            layers.extend(range(start, end + 1))
        else:
            # Handle a single layer number
            layers.append(int(part))

    # Remove duplicates and sort
    layers = sorted(list(set(layers)))

    # Validate range
    for layer in layers:
        if layer < 0 or layer >= total_layers:
            raise ValueError(f"Layer {layer} is out of range (0-{total_layers - 1})")

    return layers


def main():
    """
    Command-line entry point.

    Asks user for:
        - output filename
        - board dimensions
        - number of layers

    Then:
        1. processes data
        2. optionally exports KiCad files
        3. optionally generates before/after visualizations
        4. optionally generates comparison images/reports
    """

    print("PCB to KiCad Exporter")
    print("=" * 60)

    visualizer = PCBCoordinateMappingVisualizer()

    # -----------------------------------------
    # Gather required user input
    # -----------------------------------------
    fileName = input("Enter the output file name: ")
    boardX = int(input("Enter the board width in mm: "))
    boardY = int(input("Enter the board height in mm: "))
    layerCount = int(input("How many layers are there? "))

    # Process the board layers
    data = visualizer.process_board_data(fileName, boardX, boardY, layerCount)

    # -----------------------------------------
    # KiCad export option
    # -----------------------------------------
    print("\n" + "=" * 60)
    print("KICAD EXPORT OPTIONS")
    print("=" * 60)
    export_choice = input("Export layers to KiCad? (y/n): ").lower()

    if export_choice == 'y':
        print("\nWhich layers would you like to export?")
        print(f"Available layers: 0 to {layerCount - 1}")
        print("Examples:")
        print("  - Single layer: 0")
        print("  - Multiple layers: 0,2,4")
        print("  - Range: 0-3")
        print("  - All layers: all")

        layer_input = input("\nEnter layers to export: ").strip()

        try:
            layers_to_export = parse_layer_input(layer_input, layerCount)
            print(f"\nExporting layers: {layers_to_export}")

            # Choose output filename based on selection
            if len(layers_to_export) == 1:
                output_kicad = f"{fileName}_layer_{layers_to_export[0]}.kicad_pcb"
            elif len(layers_to_export) == layerCount:
                output_kicad = f"{fileName}_all_layers.kicad_pcb"
            else:
                layer_str = "_".join(map(str, layers_to_export))
                output_kicad = f"{fileName}_layers_{layer_str}.kicad_pcb"

            visualizer.export_layers_to_kicad(data, layers_to_export, output_kicad)

            print("\nTo open in KiCad:")
            print("1. Open KiCad PCB Editor")
            print(f"2. File > Open > Select '{output_kicad}'")
            print("3. The board should load with all pads, vias, and traces")

        except ValueError as e:
            print(f"Error: {e}")

    # -----------------------------------------
    # Before/after visualization option
    # -----------------------------------------
    print("\n" + "=" * 60)
    print("VISUALIZATION OPTIONS")
    print("=" * 60)
    viz_choice = input("Generate before/after visualizations? (y/n): ").lower()

    if viz_choice == 'y':
        print("\nWhich layers would you like to visualize?")
        print(f"Available layers: 0 to {layerCount - 1}")
        layer_input = input("Enter layers (same format as above): ").strip()

        try:
            layers_to_viz = parse_layer_input(layer_input, layerCount)
            print(f"\nCreating visualizations for layers: {layers_to_viz}")

            for layer_idx in layers_to_viz:
                print(f"\nGenerating visualization for layer {layer_idx}...")

                fig = visualizer.visualize_before_after_mapping(data, layer_idx)

                output_file = f"before_after_{fileName}_layer_{layer_idx}.png"
                fig.savefig(output_file, dpi=300, bbox_inches='tight')
                print(f"Saved: {output_file}")

                plt.close(fig)

        except ValueError as e:
            print(f"Error: {e}")

    # -----------------------------------------
    # Comparison visualization/report option
    # -----------------------------------------
    print("\n" + "=" * 60)
    print("COMPARISON OPTIONS")
    print("=" * 60)
    print("Compare original image with KiCad output")
    comp_choice = input("Generate comparison visualizations? (y/n): ").lower()

    if comp_choice == 'y':
        print("\nWhich layers would you like to compare?")
        print(f"Available layers: 0 to {layerCount - 1}")
        layer_input = input("Enter layers (same format as above): ").strip()

        try:
            layers_to_compare = parse_layer_input(layer_input, layerCount)
            print(f"\nCreating comparisons for layers: {layers_to_compare}")

            for layer_idx in layers_to_compare:
                print(f"\nGenerating comparison for layer {layer_idx}...")

                # Save image comparison
                fig = visualizer.compare_original_vs_kicad(data, layer_idx)
                output_file = f"comparison_{fileName}_layer_{layer_idx}.png"
                fig.savefig(output_file, dpi=300, bbox_inches='tight')
                print(f"Saved visual comparison: {output_file}")
                plt.close(fig)

                # Save text coordinate comparison report
                report_file = f"comparison_{fileName}_layer_{layer_idx}_report.txt"
                visualizer.generate_coordinate_comparison_report(data, layer_idx, report_file)

        except ValueError as e:
            print(f"Error: {e}")

    # -----------------------------------------
    # Final summary
    # -----------------------------------------
    print("\n" + "=" * 60)
    print("Complete!")
    print(f"Total nets created: {nx.number_connected_components(data['interConnectivity'])}")


# Run main() only if this file is executed directly
if __name__ == "__main__":
    main()
