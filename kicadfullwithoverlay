import cv2
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.patches as patches
from matplotlib.collections import LineCollection
import re
import math
import networkx as nx
from shapely.geometry import Polygon, Point
from centerline.geometry import Centerline
import os
from itertools import tee
import operator
from datetime import datetime

class PCBCoordinateMappingVisualizer:
    """Visualizes before/after coordinate mapping with correction logic from main code"""
    
    def __init__(self, img_path='boardImgs/', csv_path='boardCSV/'):
        self.img_path = img_path
        self.csv_path = csv_path
        self.IU_PER_MM = 1000000
        
    def distanceBetween(self, a, b):
        return math.sqrt((a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2)
    
    def getPointX(self, pointList):
        xMax = 0
        xMin = 150000
        for i in pointList:
            if i[0] > xMax:
                xMax = i[0]
            if i[0] < xMin:
                xMin = i[0]
        return [xMin, xMax]
    
    def anti_clockwise(self, p1, p2):
        alpha = math.degrees(math.atan2(p2[1] - p1[1], p2[0] - p1[0]))
        return (alpha + 360) % 360
    
    def pairwise(self, iterable):
        a, b = tee(iterable)
        next(b, None)
        return list(zip(a, b))
    
    def getAbsoluteAngle(self, edge1, edge2):
        v1 = tuple(map(operator.sub, edge1[0], edge1[1]))
        v2 = tuple(map(operator.sub, edge2[0], edge2[1]))
        return abs(np.degrees(math.atan2(np.linalg.det([v1, v2]), np.dot(v1, v2))))
    
    def process_board_data(self, fileName, boardX, boardY, layerCount):
        """Process data with correction logic from main code"""
        
        print("="*60)
        print("PROCESSING DATA WITH CORRECTION LOGIC")
        print("="*60)
        
        # Load images and CSVs
        imgs = []
        anns = []
        for i in range(layerCount):
            img = cv2.imread(os.path.join(self.img_path, f'l{i}.png'), cv2.IMREAD_GRAYSCALE)
            ann = pd.read_csv(os.path.join(self.csv_path, f'l{i}.csv'))
            imgs.append(img)
            anns.append(ann)
            print(f"Loaded layer {i}: image shape {img.shape}, {len(ann)} annotations")
        
        # Initialize storage
        pad_positions = []
        pad_points = []
        via_positions = []
        via_diameters = []
        linesList = []
        updatedLinesList = []
        
        # Process each layer
        for im_num, (img, ann) in enumerate(zip(imgs, anns)):
            print(f"\nProcessing layer {im_num}...")
            pad_positions.append([])
            pad_points.append([])
            via_positions.append([])
            via_diameters.append([])
            linesList.append([])
            updatedLinesList.append([])
            
            for index, row in ann.iterrows():
                coords = row['Vertices']
                coords = re.findall(r'\d+', coords)
                coords = [[int(coords[i]), int(coords[i+1])] for i in range(0, len(coords)-1, 2)]
                component_type = row['Type']
                
                xMin, xMax = self.getPointX(coords)
                
                if component_type == 'pad':
                    x = [i[0] for i in coords]
                    y = [i[1] for i in coords]
                    x = sum(x) / len(x)
                    y = sum(y) / len(y)
                    x = round(x)
                    y = round(y)
                    pad_positions[-1].append([(x, y)])
                    pad_points[-1].append(coords)
                    
                elif component_type == 'via':
                    M = cv2.moments(np.array(coords))
                    if M['m00'] != 0:
                        cx = int(M['m10'] / M['m00'])
                        cy = int(M['m01'] / M['m00'])
                        via_positions[-1].append([(cx, cy)])
                        via_diameters[-1].append(xMax - xMin)
                        
                elif component_type == 'trace':
                    try:
                        poly = Polygon(coords)
                        centerline = Centerline(poly, interpolation_distance=8)
                        
                        xList = list()
                        points = list()
                        edges = list()
                        G = nx.Graph()
                        coordList = centerline.geometry.geoms
                        
                        for i in coordList:
                            x, y = i.coords.xy
                            x = list(x)
                            y = list(y)
                            xList.append(tuple([tuple([x[0], y[0]]), tuple([x[1], y[1]])]))
                            if not tuple([x[0], y[0]]) in points:
                                points.append(tuple([x[0], y[0]]))
                            if not tuple([x[1], y[1]]) in points:
                                points.append(tuple([x[1], y[1]]))
                        
                        for i in xList:
                            edges.append([points.index(i[0]), points.index(i[1]), self.distanceBetween(i[0], i[1])])
                        
                        for i in range(len(edges)):
                            G.add_edge(points[edges[i][0]], points[edges[i][1]], length=edges[i][2])
                        
                        maxDist = 0
                        pathList = list()
                        lengths = nx.all_pairs_dijkstra_path_length(G, weight='length')
                        for i in lengths:
                            node = max(i[1], key=i[1].get)
                            if nx.shortest_path_length(G, i[0], node, weight='length') > maxDist:
                                maxDist = nx.shortest_path_length(G, i[0], node, weight='length')
                        
                        lengths2 = nx.all_pairs_dijkstra_path_length(G, weight='length')
                        for i in lengths2:
                            node = max(i[1], key=i[1].get)
                            localMax = i[1][node]
                            for key in i[1]:
                                if localMax - i[1][key] < 0.15 * localMax:
                                    temp = maxDist - nx.shortest_path_length(G, i[0], key, weight='length')
                                    if temp < 0.09 * maxDist:
                                        pathList.append(nx.shortest_path(G, i[0], key, weight='length'))
                        
                        minAngle = 999999
                        minPath = list()
                        for i in pathList:
                            angle = 0
                            for j in self.pairwise(self.pairwise(i)):
                                angle += self.getAbsoluteAngle(j[0], j[1])
                            if angle < minAngle:
                                minAngle = angle
                                minPath = i
                        
                        if len(minPath) > 0:
                            pathNew = list()
                            for i in self.pairwise(minPath[::3]):
                                pathNew.append(i)
                            
                            sharpTurns = list()
                            for i in self.pairwise(pathNew):
                                angle = self.getAbsoluteAngle(i[0], i[1])
                                if angle > 20:
                                    sharpTurns.append(i)
                            
                            newLine = list()
                            if len(sharpTurns) != 0:
                                newLine.append((minPath[0], sharpTurns[0][0][1]))
                                for i in self.pairwise(sharpTurns):
                                    newLine.append((i[0][1][0], i[1][1][0]))
                                newLine.append((sharpTurns[-1][1][0], minPath[-1]))
                            else:
                                newLine.append((minPath[0], minPath[-1]))
                            
                            newLineWidth = list()
                            for i in newLine:
                                minDist = 999999
                                for j in list(coords):
                                    if self.distanceBetween(i[0], j) < minDist:
                                        minDist = self.distanceBetween(i[0], j)
                                    if self.distanceBetween(i[1], j) < minDist:
                                        minDist = self.distanceBetween(i[1], j)
                                newLineWidth.append((i, minDist))
                            
                            linesList[-1].append(newLineWidth)
                    except Exception as e:
                        print(f"  Error processing trace: {e}")
            
            # Apply 45-degree angle snapping
            for i in linesList[-1]:
                latestEnd = i[0][0][0]
                line = list()
                for j in i:
                    angle = self.anti_clockwise(latestEnd, j[0][1])
                    mod = angle % 45
                    if mod >= 22.5:
                        rounded_angle = (angle//45+1)*45
                    else:
                        rounded_angle = (angle//45)*45
                    length = self.distanceBetween(latestEnd, j[0][1])
                    final = ((latestEnd[0] + (length*math.cos(math.radians(rounded_angle)))), 
                            (latestEnd[1] + (length*math.sin(math.radians(rounded_angle)))))
                    line.append(((latestEnd, final), j[1]))
                    latestEnd = final
                updatedLinesList[-1].append(line)
            
            print(f"  Layer {im_num}: {len(pad_positions[-1])} pads, {len(via_positions[-1])} vias, {len(updatedLinesList[-1])} traces")
        
        # Calculate coordinate transformations
        y0, x0 = 0, 0
        y1, x1 = imgs[0].shape
        MMpixelX = float(boardX) / (x1 - x0)
        MMpixelY = float(boardY) / (y1 - y0)
        MMpixel = (MMpixelX + MMpixelY) / 2
        
        print(f"\nCoordinate transformation:")
        print(f"  Image size: {x1}x{y1} pixels")
        print(f"  Board size: {boardX}x{boardY} mm")
        print(f"  MM per pixel X: {MMpixelX:.6f}")
        print(f"  MM per pixel Y: {MMpixelY:.6f}")
        
        # Build connectivity graph
        print("\nBuilding connectivity graph...")
        interConnectivity = nx.Graph()
        
        for i in range(len(via_positions)):
            for j in range(len(via_positions[i])):
                for k in range(len(via_positions)):
                    for l in range(len(via_positions[k])):
                        if abs(i - k) == 1:
                            for m in via_positions[i][j]:
                                for n in via_positions[k][l]:
                                    if self.distanceBetween(m, n) < 10:
                                        node1 = f"Via_{i}_{via_positions[i][j][0]}"
                                        node2 = f"Via_{k}_{via_positions[k][l][0]}"
                                        interConnectivity.add_edge(node1, node2)
        
        for i in range(len(via_positions)):
            for j in range(len(via_positions[i])):
                for k in range(len(pad_positions[i])):
                    for l in pad_positions[i][k]:
                        for m in via_positions[i][j]:
                            if self.distanceBetween(l, m) < 30:
                                node1 = f"Pad_{i}_{pad_positions[i][k][0]}"
                                node2 = f"Via_{i}_{via_positions[i][j][0]}"
                                interConnectivity.add_edge(node1, node2)
        
        self.connect_tracks(interConnectivity, updatedLinesList, pad_positions, pad_points, via_positions, via_diameters)
        
        # NOW THE KEY PART: Update trace endpoints to connect to pads/vias (main code correction logic)
        print("\nApplying endpoint corrections...")
        new_updatedLinesList = []
        for i in range(len(updatedLinesList)):
            new_updatedLinesList.append([])
            for j in updatedLinesList[i]:
                new_segment_list = []
                for k in j:
                    start_point = k[0][0]
                    end_point = k[0][1]
                    
                    # Find connected pad/via for start point
                    for node in interConnectivity.neighbors(f"Track_{i}_{start_point}"):
                        if node.startswith("Pad"):
                            layer, pos = node.split("_")[1:]
                            pos = tuple(float(s) for s in pos.strip("()").split(","))
                            start_point = pos
                        elif node.startswith("Via"):
                            layer, pos = node.split("_")[1:]
                            pos = tuple(float(s) for s in pos.strip("()").split(","))
                            start_point = pos
                    
                    # Find connected pad/via for end point
                    for node in interConnectivity.neighbors(f"Track_{i}_{end_point}"):
                        if node.startswith("Pad"):
                            layer, pos = node.split("_")[1:]
                            pos = tuple(float(s) for s in pos.strip("()").split(","))
                            end_point = pos
                        elif node.startswith("Via"):
                            layer, pos = node.split("_")[1:]
                            pos = tuple(float(s) for s in pos.strip("()").split(","))
                            end_point = pos
                    
                    new_segment_list.append(((start_point, end_point), k[1]))
                new_updatedLinesList[-1].append(new_segment_list)
        
        print(f"Connectivity graph: {interConnectivity.number_of_nodes()} nodes, {interConnectivity.number_of_edges()} edges")
        print(f"Connected components (nets): {nx.number_connected_components(interConnectivity)}")
        
        return {
            'imgs': imgs,
            'pad_positions': pad_positions,
            'pad_points': pad_points,
            'via_positions': via_positions,
            'via_diameters': via_diameters,
            'traces_before': updatedLinesList,
            'traces_after': new_updatedLinesList,
            'interConnectivity': interConnectivity,
            'MMpixelX': MMpixelX,
            'MMpixelY': MMpixelY,
            'MMpixel': MMpixel,
            'boardX': boardX,
            'boardY': boardY,
            'layerCount': layerCount
        }
    
    def connect_tracks(self, G, tracks, pad_positions, pad_points, via_positions, via_diameters):
        """Same connect_tracks logic from main code"""
        def distance_to_pad_border(point, pad_polygon):
            point_geom = Point(point)
            return point_geom.distance(pad_polygon.exterior)
        
        def distance_to_via_border(point, via_center, via_radius):
            return self.distanceBetween(point, via_center) - via_radius
        
        for layer in range(len(tracks)):
            for track in tracks[layer]:
                for i in range(len(track)):
                    G.add_edge(f"Track_{layer}_{track[i][0][0]}", f"Track_{layer}_{track[i][0][1]}")
        
        for layer in range(len(tracks)):
            for track in tracks[layer]:
                for i in range(len(track)):
                    if f"Track_{layer}_{track[i][0][0]}" in G and G.degree[f"Track_{layer}_{track[i][0][0]}"] == 1:
                        min_distance = float('inf')
                        nearest_pad_via = None
                        nearest_type = None
                        
                        for pad_idx, pad in enumerate(pad_positions[layer]):
                            pad_polygon = Polygon(pad_points[layer][pad_idx])
                            distance = distance_to_pad_border(track[i][0][0], pad_polygon)
                            if distance < min_distance:
                                min_distance = distance
                                nearest_pad_via = pad_positions[layer][pad_idx][0]
                                nearest_type = 'Pad'
                        
                        for via_idx, via in enumerate(via_positions[layer]):
                            via_center = via[0]
                            via_radius = via_diameters[layer][via_idx] / 2
                            distance = distance_to_via_border(track[i][0][0], via_center, via_radius)
                            if distance < min_distance:
                                min_distance = distance
                                nearest_pad_via = via_center
                                nearest_type = 'Via'
                        
                        if nearest_pad_via is not None and min_distance < 40:
                            G.add_edge(f"Track_{layer}_{track[i][0][0]}", f"{nearest_type}_{layer}_{nearest_pad_via}")
    
    def get_kicad_layer_name(self, layer_idx, total_layers):
        """Get KiCad layer name based on index and total layer count"""
        if total_layers == 2:
            return "F.Cu" if layer_idx == 0 else "B.Cu"
        else:
            if layer_idx == 0:
                return "F.Cu"
            elif layer_idx == total_layers - 1:
                return "B.Cu"
            else:
                # Internal layers are In1.Cu, In2.Cu, etc.
                return f"In{layer_idx}.Cu"
    
    def export_layers_to_kicad(self, data, layer_indices, output_filename):
        """Export selected layers to KiCad PCB format"""
        
        print(f"\n{'='*60}")
        print(f"EXPORTING LAYERS {layer_indices} TO KICAD")
        print(f"{'='*60}")
        
        MMpixelX = data['MMpixelX']
        MMpixelY = data['MMpixelY']
        MMpixel = data['MMpixel']
        boardX = data['boardX']
        boardY = data['boardY']
        layerCount = data['layerCount']
        
        # KiCad uses nanometers internally (1mm = 1000000 nm)
        IU_PER_MM = self.IU_PER_MM
        
        with open(output_filename, 'w') as f:
            # Write KiCad PCB header
            f.write('(kicad_pcb (version 20221018) (generator pcbnew)\n\n')
            
            # General settings
            f.write('  (general\n')
            f.write('    (thickness 1.6)\n')
            f.write('  )\n\n')
            
            # Paper settings
            f.write('  (paper "A4")\n\n')
            
            # Layers definition - include all necessary layers for multilayer PCB
            f.write('  (layers\n')
            f.write('    (0 "F.Cu" signal)\n')
            
            # Add internal layers if we have more than 2 layers
            if layerCount > 2:
                for i in range(1, layerCount - 1):
                    layer_num = i
                    f.write(f'    ({layer_num} "In{i}.Cu" signal)\n')
            
            # Back copper and other standard layers
            back_layer_num = layerCount - 1 if layerCount > 1 else 31
            f.write(f'    ({back_layer_num} "B.Cu" signal)\n')
            f.write('    (32 "B.Adhes" user "B.Adhesive")\n')
            f.write('    (33 "F.Adhes" user "F.Adhesive")\n')
            f.write('    (34 "B.Paste" user)\n')
            f.write('    (35 "F.Paste" user)\n')
            f.write('    (36 "B.SilkS" user "B.Silkscreen")\n')
            f.write('    (37 "F.SilkS" user "F.Silkscreen")\n')
            f.write('    (38 "B.Mask" user)\n')
            f.write('    (39 "F.Mask" user)\n')
            f.write('    (40 "Dwgs.User" user "User.Drawings")\n')
            f.write('    (41 "Cmts.User" user "User.Comments")\n')
            f.write('    (42 "Eco1.User" user "User.Eco1")\n')
            f.write('    (43 "Eco2.User" user "User.Eco2")\n')
            f.write('    (44 "Edge.Cuts" user)\n')
            f.write('    (45 "Margin" user)\n')
            f.write('    (46 "B.CrtYd" user "B.Courtyard")\n')
            f.write('    (47 "F.CrtYd" user "F.Courtyard")\n')
            f.write('    (48 "B.Fab" user)\n')
            f.write('    (49 "F.Fab" user)\n')
            f.write('  )\n\n')
            
            # Setup
            f.write('  (setup\n')
            f.write('    (pad_to_mask_clearance 0)\n')
            f.write('    (pcbplotparams\n')
            f.write('      (layerselection 0x00010fc_ffffffff)\n')
            f.write('      (plot_on_all_layers_selection 0x0000000_00000000)\n')
            f.write('      (disableapertmacros false)\n')
            f.write('      (usegerberextensions false)\n')
            f.write('      (usegerberattributes true)\n')
            f.write('      (usegerberadvancedattributes true)\n')
            f.write('      (creategerberjobfile true)\n')
            f.write('      (dashed_line_dash_ratio 12.000000)\n')
            f.write('      (dashed_line_gap_ratio 3.000000)\n')
            f.write('      (svgprecision 4)\n')
            f.write('      (plotframeref false)\n')
            f.write('      (viasonmask false)\n')
            f.write('      (mode 1)\n')
            f.write('      (useauxorigin false)\n')
            f.write('      (hpglpennumber 1)\n')
            f.write('      (hpglpenspeed 20)\n')
            f.write('      (hpglpendiameter 15.000000)\n')
            f.write('      (dxfpolygonmode true)\n')
            f.write('      (dxfimperialunits true)\n')
            f.write('      (dxfusepcbnewfont true)\n')
            f.write('      (psnegative false)\n')
            f.write('      (psa4output false)\n')
            f.write('      (plotreference true)\n')
            f.write('      (plotvalue true)\n')
            f.write('      (plotinvisibletext false)\n')
            f.write('      (sketchpadsonfab false)\n')
            f.write('      (subtractmaskfromsilk false)\n')
            f.write('      (outputformat 1)\n')
            f.write('      (mirror false)\n')
            f.write('      (drillshape 1)\n')
            f.write('      (scaleselection 1)\n')
            f.write('      (outputdirectory "")\n')
            f.write('    )\n')
            f.write('  )\n\n')
            
            # Board outline on Edge.Cuts layer
            f.write('  (gr_rect (start 12 12) (end {} {}) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts") (tstamp {}))\n\n'.format(
                12 + boardX, 12 + boardY, self.generate_uuid()
            ))
            
            # Generate nets from connectivity graph
            print("Generating nets...")
            nets = list(nx.connected_components(data['interConnectivity']))
            net_mapping = {}
            
            f.write('  (net 0 "")\n')  # Net 0 is always empty
            
            for net_idx, net_nodes in enumerate(nets, start=1):
                f.write(f'  (net {net_idx} "Net-{net_idx}")\n')
                for node in net_nodes:
                    net_mapping[node] = net_idx
            
            f.write('\n')
            
            print(f"Created {len(nets)} nets")
            
            # Export components for each selected layer
            for layer_idx in layer_indices:
                kicad_layer = self.get_kicad_layer_name(layer_idx, layerCount)
                print(f"\nExporting Layer {layer_idx} ({kicad_layer})...")
                
                # Export pads
                print(f"  Exporting {len(data['pad_positions'][layer_idx])} pads...")
                for pad_idx, (pad_pts, pad_pos) in enumerate(zip(data['pad_points'][layer_idx], 
                                                                 data['pad_positions'][layer_idx])):
                    # Calculate pad center in KiCad coordinates
                    sumX = sum([p[0] for p in pad_pts])
                    sumY = sum([p[1] for p in pad_pts])
                    avgPoint = (sumX / len(pad_pts), sumY / len(pad_pts))
                    
                    center_x = avgPoint[0] * MMpixelX + 12
                    center_y = avgPoint[1] * MMpixelY + 12
                    
                    # Calculate pad size
                    x_coords = [p[0] for p in pad_pts]
                    y_coords = [p[1] for p in pad_pts]
                    pad_width = (max(x_coords) - min(x_coords)) * MMpixelX
                    pad_height = (max(y_coords) - min(y_coords)) * MMpixelY
                    
                    # Get net number
                    node_name = f"Pad_{layer_idx}_{pad_pos[0]}"
                    net_num = net_mapping.get(node_name, 0)
                    
                    # Write footprint with pad
                    f.write(f'  (footprint "Pad_L{layer_idx}_{pad_idx}" (layer "{kicad_layer}")\n')
                    f.write(f'    (tstamp {self.generate_uuid()})\n')
                    f.write(f'    (at {center_x} {center_y})\n')
                    f.write(f'    (attr smd)\n')
                    f.write(f'    (pad "1" smd rect (at 0 0) (size {pad_width} {pad_height}) (layers "{kicad_layer}" "*.Paste" "*.Mask")\n')
                    f.write(f'      (net {net_num} "Net-{net_num}") (tstamp {self.generate_uuid()}))\n')
                    f.write(f'  )\n\n')
                
                # Export vias (vias span all layers, but we only write them once from first selected layer)
                if layer_idx == layer_indices[0]:
                    via_count = sum(len(data['via_positions'][l]) for l in layer_indices)
                    print(f"  Exporting {via_count} vias (span all layers)...")
                    
                    for via_layer_idx in layer_indices:
                        for via_idx, via_pos in enumerate(data['via_positions'][via_layer_idx]):
                            for pos in via_pos:
                                center_x = pos[0] * MMpixelX + 12
                                center_y = pos[1] * MMpixelY + 12
                                diameter = data['via_diameters'][via_layer_idx][via_idx] * MMpixel
                                drill = diameter * 0.6  # Drill is typically 60% of via diameter
                                
                                # Get net number
                                node_name = f"Via_{via_layer_idx}_{pos}"
                                net_num = net_mapping.get(node_name, 0)
                                
                                f.write(f'  (via (at {center_x} {center_y}) (size {diameter}) (drill {drill}) ')
                                f.write(f'(layers "F.Cu" "B.Cu") (net {net_num}) (tstamp {self.generate_uuid()}))\n')
                    
                    f.write('\n')
                
                # Export traces (using corrected coordinates)
                print(f"  Exporting {len(data['traces_after'][layer_idx])} traces...")
                for trace_idx, trace in enumerate(data['traces_after'][layer_idx]):
                    for segment in trace:
                        start, end = segment[0]
                        width = segment[1]
                        
                        start_x = start[0] * MMpixelX + 12
                        start_y = start[1] * MMpixelY + 12
                        end_x = end[0] * MMpixelX + 12
                        end_y = end[1] * MMpixelY + 12
                        trace_width = width * MMpixel
                        
                        # Try to find net number from connectivity
                        net_num = 0
                        start_node = f"Track_{layer_idx}_{start}"
                        if start_node in data['interConnectivity']:
                            for neighbor in data['interConnectivity'].neighbors(start_node):
                                if neighbor in net_mapping:
                                    net_num = net_mapping[neighbor]
                                    break
                        
                        f.write(f'  (segment (start {start_x} {start_y}) (end {end_x} {end_y}) ')
