                    kicad_x = pixel_x * MMpixelX + 12
                    kicad_y = pixel_y * MMpixelY + 12
                    
                    diameter = data['via_diameters'][layer_idx][via_idx] * MMpixelX
                    drill = diameter * 0.6
                    
                    f.write(f"\nVia {via_idx}:\n")
