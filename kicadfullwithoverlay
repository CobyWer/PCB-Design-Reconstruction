        with open(output_filename, 'w') as f:
            f.write(f"COORDINATE COMPARISON REPORT - Layer {layer_idx}\n")
            f.write("="*80 + "\n\n")
            
            f.write(f"Board Dimensions: {data['boardX']} x {data['boardY']} mm\n")
            f.write(f"Conversion Factor: {MMpixelX:.6f} mm/pixel (X), {MMpixelY:.6f} mm/pixel (Y)\n\n")
            
            # Pad comparison
            f.write(f"PADS ({len(data['pad_positions'][layer_idx])} total)\n")
            f.write("-"*80 + "\n")
            for pad_idx, (pad_pts, pad_pos) in enumerate(zip(data['pad_points'][layer_idx], 
                                                             data['pad_positions'][layer_idx])):
                sumX = sum([p[0] for p in pad_pts])
                sumY = sum([p[1] for p in pad_pts])
                avgPoint = (sumX / len(pad_pts), sumY / len(pad_pts))
                
                # Pixel coordinates
                pixel_x = avgPoint[0]
                pixel_y = avgPoint[1]
                
                # KiCad coordinates (mm)
                kicad_x = pixel_x * MMpixelX + 12
                kicad_y = pixel_y * MMpixelY + 12
                
                # Pad size
                x_coords = [p[0] for p in pad_pts]
                y_coords = [p[1] for p in pad_pts]
                pad_width = (max(x_coords) - min(x_coords)) * MMpixelX
                pad_height = (max(y_coords) - min(y_coords)) * MMpixelY
                
                f.write(f"\nPad {pad_idx}:\n")
                f.write(f"  Original (pixels): ({pixel_x:.2f}, {pixel_y:.2f})\n")
                f.write(f"  KiCad (mm):        ({kicad_x:.3f}, {kicad_y:.3f})\n")
                f.write(f"  Size (mm):         {pad_width:.3f} x {pad_height:.3f}\n")
            
            # Via comparison
            f.write(f"\n\nVIAS ({len(data['via_positions'][layer_idx])} total)\n")
            f.write("-"*80 + "\n")
            for via_idx, via_pos in enumerate(data['via_positions'][layer_idx]):
                for pos in via_pos:
                    pixel_x = pos[0]
