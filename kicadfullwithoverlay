                line_width = max(0.5, width * MMpixel)
                ax.plot([start_x, end_x], [start_y, end_y], 'g-', linewidth=line_width, alpha=0.6)

        # -----------------------------------------
        # BOTTOM RIGHT: after correction in KiCad-space mm coordinates
        # -----------------------------------------
        ax = axes[1, 1]
        ax.set_xlim(0, boardX + 24)
        ax.set_ylim(boardY + 24, 0)
        ax.set_aspect('equal')
        ax.set_title('AFTER Correction: KiCad MM Coordinates (Final)')
        ax.set_xlabel('MM (X)')
        ax.set_ylabel('MM (Y)')
        ax.grid(True, alpha=0.3)

        board_rect = patches.Rectangle((12, 12), boardX, boardY,
                                       fill=False, edgecolor='black', linewidth=2)
        ax.add_patch(board_rect)

        for pad_idx, (pad_pts, pad_pos) in enumerate(zip(data['pad_points'][layer_idx],
                                                         data['pad_positions'][layer_idx])):
            sumX = sum([p[0] for p in pad_pts])
            sumY = sum([p[1] for p in pad_pts])
            avgPoint = (sumX / len(pad_pts), sumY / len(pad_pts))
            adjusted_points = [(p[0] - avgPoint[0], p[1] - avgPoint[1]) for p in pad_pts]

            transformed_pts = [
                ((p[0] * MMpixelX) + avgPoint[0] * MMpixelX + 12,
                 (p[1] * MMpixelY) + avgPoint[1] * MMpixelY + 12)
                for p in adjusted_points
            ]

            pad_polygon = patches.Polygon(transformed_pts, closed=True,
                                          facecolor='red', edgecolor='darkred', alpha=0.7)
            ax.add_patch(pad_polygon)

        for via_idx, via_pos in enumerate(data['via_positions'][layer_idx]):
            for pos in via_pos:
                center_x = pos[0] * MMpixelX + 12
                center_y = pos[1] * MMpixelY + 12
                radius = (data['via_diameters'][layer_idx][via_idx] * MMpixelX) / 2

                circle = patches.Circle((center_x, center_y), radius,
                                        facecolor='blue', edgecolor='darkblue', alpha=0.7)
                ax.add_patch(circle)

        # Draw traces after correction in mm space
        for trace in data['traces_after'][layer_idx]:
            for segment in trace:
                start, end = segment[0]
                width = segment[1]

                start_x = start[0] * MMpixelX + 12
                start_y = start[1] * MMpixelY + 12
                end_x = end[0] * MMpixelX + 12
                end_y = end[1] * MMpixelY + 12

                line_width = max(0.5, width * MMpixel)
                ax.plot([start_x, end_x], [start_y, end_y], 'orange', linewidth=line_width, alpha=0.8)

        plt.tight_layout()
        return fig

