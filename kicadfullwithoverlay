                    if start_changed or end_changed:
                        corrections_made += 1
                        f.write(f"  Segment {seg_idx}: ** CORRECTED **\n")
                    else:
                        f.write(f"  Segment {seg_idx}:\n")
                    
                    # Original coordinates
                    f.write(f"    Original Start (pixels): ({start_before[0]:.2f}, {start_before[1]:.2f})\n")
                    f.write(f"    Original End (pixels):   ({end_before[0]:.2f}, {end_before[1]:.2f})\n")
                    
                    # KiCad coordinates
                    kicad_start_x = start_after[0] * MMpixelX + 12
                    kicad_start_y = start_after[1] * MMpixelY + 12
                    kicad_end_x = end_after[0] * MMpixelX + 12
                    kicad_end_y = end_after[1] * MMpixelY + 12
                    
                    f.write(f"    KiCad Start (mm):        ({kicad_start_x:.3f}, {kicad_start_y:.3f})\n")
                    f.write(f"    KiCad End (mm):          ({kicad_end_x:.3f}, {kicad_end_y:.3f})\n")
                    f.write(f"    Width (mm):              {width * MMpixelX:.3f}\n")
                    
                    if start_changed or end_changed:
                        # Calculate movement
                        if start_changed:
                            start_movement = math.sqrt(
                                (start_after[0] - start_before[0])**2 + 
                                (start_after[1] - start_before[1])**2
                            )
                            f.write(f"    Start moved: {start_movement:.2f} pixels\n")
                        
                        if end_changed:
                            end_movement = math.sqrt(
                                (end_after[0] - end_before[0])**2 + 
                                (end_after[1] - end_before[1])**2
                            )
                            f.write(f"    End moved:   {end_movement:.2f} pixels\n")
            
            # Summary
