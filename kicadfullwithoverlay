                    f.write(f"  KiCad (mm):        ({kicad_x:.3f}, {kicad_y:.3f})\n")
                    f.write(f"  Diameter (mm):     {diameter:.3f}\n")
                    f.write(f"  Drill (mm):        {drill:.3f}\n")
            
            # Trace comparison
            f.write(f"\n\nTRACES ({len(data['traces_after'][layer_idx])} total)\n")
            f.write("-"*80 + "\n")
            
            corrections_made = 0
            total_segments = 0
            
            for trace_idx, (trace_before, trace_after) in enumerate(zip(
                data['traces_before'][layer_idx], 
                data['traces_after'][layer_idx]
            )):
                f.write(f"\nTrace {trace_idx} ({len(trace_after)} segments):\n")
                
                for seg_idx, (seg_before, seg_after) in enumerate(zip(trace_before, trace_after)):
                    total_segments += 1
                    
                    start_before, end_before = seg_before[0]
                    start_after, end_after = seg_after[0]
