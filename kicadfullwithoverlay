def parse_layer_input(user_input, total_layers):
    """Parse user input for layer selection
    
    Examples:
        "0" -> [0]
        "0,2,4" -> [0, 2, 4]
        "0-3" -> [0, 1, 2, 3]
        "all" -> [0, 1, 2, ..., total_layers-1]
    """
    user_input = user_input.strip().lower()
    
    if user_input == 'all':
        return list(range(total_layers))
    
    layers = []
    parts = user_input.split(',')
    
    for part in parts:
        part = part.strip()
        if '-' in part:
            # Range like "0-3"
            start, end = part.split('-')
            start = int(start.strip())
            end = int(end.strip())
            layers.extend(range(start, end + 1))
        else:
            # Single layer
            layers.append(int(part))
    
    # Remove duplicates and sort
    layers = sorted(list(set(layers)))
    
    # Validate
    for layer in layers:
        if layer < 0 or layer >= total_layers:
            raise ValueError(f"Layer {layer} is out of range (0-{total_layers-1})")
    
    return layers


