                fig.savefig(output_file, dpi=300, bbox_inches='tight')
                print(f"Saved visual comparison: {output_file}")
                plt.close(fig)
                
                # Text report
                report_file = f"comparison_{fileName}_layer_{layer_idx}_report.txt"
                visualizer.generate_coordinate_comparison_report(data, layer_idx, report_file)
                
        except ValueError as e:
            print(f"Error: {e}")
    
    print("\n" + "="*60)
    print("Complete!")
    print(f"Total nets created: {nx.number_connected_components(data['interConnectivity'])}")


